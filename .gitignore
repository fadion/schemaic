# Rust build output
/target
**/*.rs.bk

# Velopack packaging output. `dist/` is the staged pack directory and `Releases/`
# is what `vpk pack` writes into — both are produced by `release.yml`, and both
# get recreated locally when rehearsing a release by hand
# (`review/user-verify-autoupdate.md`, §2). Around 105 MB of binaries between
# them, and a stray `git add -A` would happily commit the lot.
/dist/
/Releases/

# Generated third-party license manifest (regenerate with cargo-about)
/THIRD-PARTY-LICENSES.html

# Claude Code: ignore everything under .claude/ (per-machine permissions in
# settings.local.json, etc.) EXCEPT the shared subagent and skill definitions,
# which are checked in so the whole team gets them.
.claude/*
!.claude/agents/
!.claude/skills/

# Private working notes — kept local, never published.
TODO.md

# Codebase-review working notes (plan, ledger, fact sheet). The reusable review
# skills live in .claude/skills/ and ARE checked in; only the per-round output
# is private.
/review/

# Stray smoke-test capture files (redirected stdout/stderr from launch checks)
scratch_out.txt
scratch_err.txt
se.txt
so.txt

# Editor / IDE folders
.vscode/
.idea/
.vs/
.zed/
*.iml
*.sublime-workspace
*.sublime-project

# Editor swap / backup files
*.swp
*.swo
*~
\#*\#
.\#*
Session.vim

# OS cruft
.DS_Store
Thumbs.db
desktop.ini
