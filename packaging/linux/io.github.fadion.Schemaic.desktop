[Desktop Entry]
Type=Application
Name=Schemaic
GenericName=SQL Editor
Comment=A fast, native SQL editor for MySQL, MariaDB, PostgreSQL and SQLite
Exec=schemaic
Icon=io.github.fadion.Schemaic
Terminal=false
Categories=Development;Database;
Keywords=SQL;MySQL;MariaDB;PostgreSQL;SQLite;database;query;editor;
# False on purpose: startup notification is a handshake, and the app has to
# announce that it has finished launching. floem never consumes
# DESKTOP_STARTUP_ID or calls winit's activation-token API, so declaring true
# earns a busy cursor that spins until the desktop times it out - worse than no
# feedback at all.
StartupNotify=false
# The window's application id - Wayland `app_id`, X11 `WM_CLASS` - is this
# file's own name, io.github.fadion.Schemaic (`schemaic_core::APP_ID`, set
# through a patch to the vendored floem, vendor/floem/PATCHES.md). A shell
# matches a window to the entry whose name that is, which is what gives it the
# icon below, on Wayland and X11 alike; no line here is needed for it.
#
# This line is for builds from before that patch. They sent no Wayland id at
# all, and on X11 winit fell back to argv[0] for WM_CLASS - `schemaic` - so this
# is what matched them there. It stays because an AppImage install fetches this
# file from `main` while the binary beside it comes from the latest release, and
# the two can be any number of commits apart. It does not stop the name match
# above: GNOME tries both.
StartupWMClass=schemaic
